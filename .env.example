# Is file ko copy karke ".env" naam se banao (sirf apne computer par testing ke liye).
# Render par ye values "Environment Variables" me daalni hoti hain. .env ko GitHub par KABHI upload mat karo.

# MongoDB Atlas se mila connection string (password ke saath)
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Koi bhi lamba random text (kam se kam 32 akshar). Isse login tokens sign hote hain.
JWT_SECRET=yahan-koi-lamba-random-text-likho-1234567890abcdef

# Admin ka pehla password. Admin panel ke Settings se badalne ke baad ye use nahi hota.
ADMIN_PASSWORD=teacher123

# GitHub Pages ka address (path ke bina). Example: https://rahul.github.io
# Khaali chhodoge to har website se request allow ho jayegi (sirf testing ke liye).
FRONTEND_ORIGIN=https://YOUR-USERNAME.github.io

# Optional
# DB_NAME=classroompoll
# PORT=3000
